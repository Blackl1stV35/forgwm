%% jmlr2e.sty - Official JMLR style file (v2e)
%% Reconstructed per http://www.jmlr.org/author-info.html
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{jmlr2e}[2024/01/01 JMLR Style v2e]

\RequirePackage{amsmath,amssymb,amsthm}
\RequirePackage{natbib}
\RequirePackage{hyperref}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{booktabs}
\RequirePackage{microtype}
\RequirePackage{times}
\RequirePackage[margin=1in,top=1.25in,bottom=1.25in]{geometry}
\RequirePackage{fancyhdr}

%% ── Theorem environments (official JMLR set) ──────────────────────────
\theoremstyle{plain}
\newtheorem{theorem}{Theorem}
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{corollary}[theorem]{Corollary}
\newtheorem{proposition}[theorem]{Proposition}
\theoremstyle{definition}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{example}[theorem]{Example}
\newtheorem{remark}[theorem]{Remark}

%% ── Metadata commands ─────────────────────────────────────────────────
\def\jmlrheading#1#2#3#4#5#6#7{%
  \gdef\@jmlrvol{#1}%
  \gdef\@jmlryear{#2}%
  \gdef\@jmlrpages{#3}%
  \gdef\@jmlrsubmitted{#4}%
  \gdef\@jmlrpublished{#5}%
  \gdef\@jmlreditor{#7}%
}
\gdef\@jmlrvol{?}
\gdef\@jmlryear{2026}
\gdef\@jmlrpages{1--?}
\gdef\@jmlrsubmitted{??/??}
\gdef\@jmlrpublished{??/??}
\gdef\@jmlreditor{}
\gdef\@shorttitle{}
\gdef\@shortauthor{}

\def\ShortHeadings#1#2{\gdef\@shorttitle{#1}\gdef\@shortauthor{#2}}
\def\editor#1{\gdef\@jmlreditor{#1}}
\newcommand{\name}[1]{#1}
\newcommand{\addr}[1]{\\ \small\textit{#1}}
\newcommand{\email}[1]{\\ \small\texttt{#1}}

%% ── Abstract and keywords ─────────────────────────────────────────────
\renewenvironment{abstract}{%
  \begin{center}{\bfseries Abstract}\end{center}%
  \begin{quotation}\small
}{%
  \end{quotation}
}
\newcommand{\keywords}[1]{\par\noindent\textbf{Keywords:} #1\par}

%% ── Page style ────────────────────────────────────────────────────────
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE,RO]{\small\thepage}
\fancyhead[RE]{\small Journal of Machine Learning Research \@jmlrvol\ (\@jmlryear) \@jmlrpages}
\fancyhead[LO]{\small\@shortauthor}
\renewcommand{\headrulewidth}{0pt}
\setlength{\headheight}{14pt}

%% ── Section formatting ────────────────────────────────────────────────
\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {-3.5ex \@plus -1ex \@minus -.2ex}%
  {2.3ex \@plus.2ex}%
  {\normalfont\large\bfseries}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {-3.25ex\@plus -1ex \@minus -.2ex}%
  {1.5ex \@plus .2ex}%
  {\normalfont\normalsize\bfseries}}

\hypersetup{colorlinks=true,linkcolor=black,citecolor=black,urlcolor=blue}
