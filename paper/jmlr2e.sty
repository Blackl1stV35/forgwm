%% jmlr2e.sty - JMLR style file (reconstructed per official spec)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{jmlr2e}[2022/01/01 JMLR Style]

\RequirePackage{amsmath,amssymb,amsthm}
\RequirePackage{natbib}
\RequirePackage{hyperref}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{booktabs}
\RequirePackage{microtype}
\RequirePackage{algorithm}
\RequirePackage{algorithmic}

% Page layout
\RequirePackage[margin=1in,top=1.25in,bottom=1.25in]{geometry}

% Fonts
\RequirePackage{times}

% Section formatting
\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {-3.5ex \@plus -1ex \@minus -.2ex}%
  {2.3ex \@plus.2ex}%
  {\normalfont\large\bfseries}}

% Theorem environments per JMLR spec
\theoremstyle{plain}
\newtheorem{theorem}{Theorem}
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{corollary}[theorem]{Corollary}
\newtheorem{proposition}[theorem]{Proposition}
\theoremstyle{definition}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{example}[theorem]{Example}
\newtheorem{remark}[theorem]{Remark}

% Title formatting
\def\jmlrtitle#1{\gdef\@jmlrtitle{#1}}
\def\jmlrauthor#1{\gdef\@jmlrauthor{#1}}
\def\jmlraddress#1{\gdef\@jmlraddress{#1}}
\def\jmlremail#1{\gdef\@jmlremail{#1}}
\def\jmlrsubmitted#1{\gdef\@jmlrsubmitted{#1}}
\def\jmlrpublished#1{\gdef\@jmlrpublished{#1}}
\def\jmlreditor#1{\gdef\@jmlreditor{#1}}
\def\jmlrvolume#1{\gdef\@jmlrvolume{#1}}
\def\jmlryear#1{\gdef\@jmlryear{#1}}
\def\jmlrpages#1{\gdef\@jmlrpages{#1}}

\newcommand{\@jmlrtitle}{}
\newcommand{\@jmlrauthor}{}
\newcommand{\@jmlraddress}{}
\newcommand{\@jmlremail}{}

% Abstract
\renewenvironment{abstract}{%
  \begin{center}{\bfseries Abstract}\end{center}%
  \begin{quotation}\small
}{%
  \end{quotation}
}

% Keywords command
\newcommand{\keywords}[1]{\par\noindent\textbf{Keywords:} #1}

% Header/footer
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE,RO]{\thepage}
\fancyhead[RE]{\textit{Journal of Machine Learning Research}}
\fancyhead[LO]{\textit{\@jmlrauthor}}
\renewcommand{\headrulewidth}{0pt}

\hypersetup{
  colorlinks=true,
  linkcolor=black,
  citecolor=black,
  urlcolor=blue
}
